#include "version.h"

// Manifest; needed for getting Windows version to detect UCS2 subsystem.
1 24 "test_manifest.xml"

1 VERSIONINFO
    FILEVERSION VERSION_MAJOR, VERSION_MINOR, 0, VERSION_PATCH
    PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, 0, VERSION_PATCH
{
    BLOCK "StringFileInfo" {
        BLOCK "040904b0" {
            VALUE "CompanyName",     "Christopher Antos"
            VALUE "ProductName",     "Test"
            VALUE "FileDescription", "Terminal Input Box Test Program"
            VALUE "InternalName",    "Test"
            VALUE "ProductVersion",  VERSION_STR
            VALUE "FileVersion",     VERSION_STR
            VALUE "LegalCopyright",  COPYRIGHT_STR
        }
    }
    BLOCK "VarFileInfo" {
        VALUE "Translation", 0x0409, 1200
    }
}

